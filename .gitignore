*.tmp
*.temp
*.partial
*.partial.7z
*.part

# Backups manuais e cópias antigas de scripts
*.bak
*.bak-*
*.backup
*.old
*.orig
*.copy
* - Copy.*
* - Copia.*
* - Cópia.*

# Logs e relatórios soltos
*.log
*.html

